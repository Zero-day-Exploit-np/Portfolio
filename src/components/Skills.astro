---
import { skillCategories } from "../content/site";
import Icon from "./Icon.astro";

const catIcons: Record<string, string> = {
  "Programming Languages": "code",
  "Systems & Tools": "terminal",
  "Backend & Database": "server",
  "CS Foundations": "cpu",
};
---

<section class="section section-alt" id="skills">
  <div class="container">
    <div class="skills-head reveal">
      <p class="eyebrow">skills</p>
      <h2 class="section-title">Technical stack</h2>
      <p class="section-lead">
        A focused toolkit built around systems programming and backend
        engineering — only technologies backed by real project experience.
      </p>
    </div>

    <div class="skills-grid">
      {
        skillCategories.map((cat, i) => (
          <div class="skill-card reveal" style={`--d:${i * 0.06}s`}>
            <div class="skill-head">
              <span class="skill-ic">
                <Icon name={catIcons[cat.name] ?? "spark"} size={18} />
              </span>
              <div>
                <h3>{cat.name}</h3>
                <p class="skill-desc">{cat.description}</p>
              </div>
            </div>
            <div class="cluster skill-tags">
              {cat.items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills-head {
    margin-bottom: 2.5rem;
    max-width: 60ch;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .skill-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .skill-card:hover {
    border-color: var(--border-strong);
  }
  .skill-head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 1.1rem;
  }
  .skill-ic {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-sm);
    color: var(--accent-bright);
    background: var(--accent-softer);
    border: 1px solid var(--border-accent);
    flex-shrink: 0;
  }
  .skill-head h3 {
    font-size: 1.02rem;
    margin-bottom: 0.2rem;
  }
  .skill-desc {
    font-size: 0.83rem;
    color: var(--text-muted);
  }
  .skill-tags {
    gap: 0.45rem;
  }
  .skill-tags .tag {
    font-size: 0.78rem;
  }
  @media (min-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
