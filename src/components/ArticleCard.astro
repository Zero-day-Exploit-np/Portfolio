---
import type { Article } from "../content/site";
import Icon from "./Icon.astro";

interface Props {
  article: Article;
}
const { article } = Astro.props;
const date = new Date(article.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a href={`/blog/${article.slug}`} class="article-card card card-hover reveal">
  <div class="ac-meta">
    <span class="ac-date">
      <Icon name="calendar" size={13} /> {date}
    </span>
    <span class="ac-read">{article.readingTime}</span>
  </div>
  <h3 class="ac-title">{article.title}</h3>
  <p class="ac-excerpt">{article.excerpt}</p>
  <div class="cluster ac-tags">
    {article.tags.map((t) => <span class="tag">{t}</span>)}
  </div>
  <span class="ac-more">Read article <Icon name="arrow-right" size={14} /></span>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .ac-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .ac-date {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .ac-title {
    font-size: 1.12rem;
    margin-bottom: 0.5rem;
    transition: color 0.2s var(--ease);
  }
  .article-card:hover .ac-title {
    color: var(--accent-bright);
  }
  .ac-excerpt {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.9rem;
  }
  .ac-tags {
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .ac-tags .tag {
    font-size: 0.72rem;
  }
  .ac-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-bright);
  }
</style>
